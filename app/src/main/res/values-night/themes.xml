        <item name="android:fontFamily">@font/outfit_regular</item>
        <!--Transparent Navigation Bar-->
        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>
        <!--Modern popup box theming-->
        <item name="popupMenuBackground">@drawable/custom_popup_background</item>
        <!--Allowing the modern toolbar to work-->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>


        <!-- Global Font Family Default -->
        <item name="fontFamily">@font/outfit_regular</item>

        <!-- FORCE TextViews and Buttons to use the font -->
        <item name="android:textViewStyle">@style/HiClub.Widget.TextView</item>
        <item name="materialButtonStyle">@style/HiClub.Widget.Button</item>

        <!-- TYPOGRAPHY OVERRIDES -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.HiClub.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.HiClub.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.HiClub.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.HiClub.HeadlineLarge</item>
